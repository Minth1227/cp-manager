function tmpl_01_05(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>사실 확인서 (상황허가용)</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-title" style="margin-top:40px;">사 실 확 인 서</div>
<div style="margin: 40px 0; font-size:11pt; line-height: 1.8;">
  <p><strong>수신:</strong> 산업통상자원부장관 귀하</p>
  <p><strong>제출일자:</strong> ${v(data,'submitDate')}</p>
  <p><strong>제출업체:</strong> ${v(data,'companyName')}</p>
  <p><strong>대표자:</strong> ${v(data,'ceoName')}</p>
  <br>
  <p><strong>[확인 대상 제출 서류]</strong></p>
  <div style="background:#f9f9f9; padding: 10px; border: 1px solid #ccc; white-space:pre-wrap; margin-bottom: 20px;">${v(data,'targetDocs')}</div>

// ─── 부속서류 (L-03 ~ L-09) ───
function tmpl_01_03(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제2호 - 최종수하인 및 구매자 진술서</title>${commonStyle}</head><body>${printButton}

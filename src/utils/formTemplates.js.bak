// ============================================
// 별지 서식 HTML 템플릿
// 각 별지를 HTML 테이블로 충실히 재현
// ============================================

const commonStyle = `
<style>
  @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css');
  * { margin: 0; padding: 0; box-sizing: border-box; }

  /* ── 화면 표시용 ── */
  @media screen {
    body { padding: 20mm; max-width: 210mm; margin: 0 auto; }
  }

  /* ── 공통 타이포그래피 ── */
  /* [수정 #13] 기업 내부망/오프라인 환경 대비 fallback 폰트 스택 강화 */
  body {
    font-family: 'Pretendard Variable', 'Apple SD Gothic Neo', '맑은 고딕', 'Malgun Gothic', 'NanumGothic', Dotum, sans-serif;
    font-size: 10pt; color: #111; line-height: 1.5;
  }
  .byeolji-title { text-align: center; font-size: 16pt; font-weight: 700; margin: 10px 0 20px; }
  .byeolji-subtitle { text-align: left; font-size: 8pt; color: #666; margin-bottom: 5px; }
  .byeolji-table { width: 100%; border-collapse: collapse; margin: 10px 0; }
  .byeolji-table th, .byeolji-table td { border: 1px solid #333; padding: 5px 8px; font-size: 9pt; vertical-align: middle; }
  .byeolji-table th { background: #f5f5f5; font-weight: 600; text-align: center; }
  .byeolji-table td.value { min-height: 22px; }
  .byeolji-table .label-cell { background: #f9f9f9; font-weight: 500; width: 120px; }
  .byeolji-table .label-cell-wide { background: #f9f9f9; font-weight: 500; width: 180px; }
  .eng { font-size: 7.5pt; color: #555; display: block; }
  .checkbox { font-size: 12pt; }
  .signature-area { margin-top: 30px; text-align: center; line-height: 2; }
  .note-area { margin-top: 15px; font-size: 8pt; color: #666; border-top: 1px solid #ccc; padding-top: 10px; }
  .print-btn { position: fixed; top: 10px; right: 10px; padding: 8px 20px; background: #2563eb; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 12px; z-index: 9999; }
  .print-btn:hover { background: #1d4ed8; }

  /* ── 인쇄 전용 ── */
  /* [수정 #8] page-break-inside 누락 추가 — A4 출력 시 테이블 행/서명영역 잘림 방지 */
  /* [수정 #9] body padding + @page margin 이중 여백 해소 → @page margin이 전담 */
  @media print {
    body { padding: 0; margin: 0; }
    @page { size: A4 portrait; margin: 15mm 20mm; }   /* 관공서 표준 여백 */

    .print-btn { display: none; }

    /* 테이블 행 페이지 경계 분할 방지 */
    .byeolji-table { page-break-inside: auto; }
    .byeolji-table tr { page-break-inside: avoid; page-break-after: auto; }
    /* 멀티페이지 테이블에서 헤더 반복 표시 */
    .byeolji-table thead { display: table-header-group; }
    .byeolji-table tfoot { display: table-footer-group; }

    /* 서명 영역 및 주의사항 분할 방지 */
    .signature-area { page-break-inside: avoid; }
    .note-area { page-break-inside: avoid; }
  }
</style>
`;

const printButton = '<button class="print-btn" onclick="window.print()">🖨️ 인쇄 / PDF 저장</button>';

function ck(val, target) {
  return val === target ? '☑' : '☐';
}
function v(data, key, fallback) {
  return data[key] || fallback || '';
}

// ─── 별지 제4호: 전문판정(신청)서 ───
function tmpl_04(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제4호 - 전문판정(신청)서</title>${commonStyle}</head><body>${printButton}
<div style="display: flex; justify-content: space-between; align-items: flex-end;">
  <div class="byeolji-subtitle" style="margin-bottom: 0;">[별지 제4호 서식] Annexed paper No. 4</div>
  <table style="border-collapse: collapse; text-align: center; font-size: 8pt; line-height: 1.2;">
    <tr>
      <td style="border: 1px solid #333; padding: 4px 8px; background: #f9f9f9;">처리기간<br><span class="eng">Handling Time</span></td>
      <td style="border: 1px solid #333; padding: 4px 15px;">15일<br><span class="eng">15 days</span></td>
    </tr>
  </table>
</div>
<div class="byeolji-title">전략물자 전문판정(신청)서<br><span style="font-size:11pt">Classification (Application) Form</span></div>
<table class="byeolji-table">
  <tr>
    <th rowspan="4" style="width:100px">① 신청인<br><span class="eng">Applicant</span></th>
    <td class="label-cell">상 호<span class="eng">Name of Company</span></td>
    <td class="value">${v(data,'companyName')}</td>
    <td class="label-cell">신청인<span class="eng">Applicant</span></td>
    <td class="value">${v(data,'applicantName')}</td>
  </tr>
  <tr>
    <td class="label-cell">주 소<span class="eng">Address</span></td>
    <td class="value">${v(data,'address')}</td>
    <td class="label-cell">사업자등록번호<span class="eng">Business Registration No.</span></td>
    <td class="value">${v(data,'regNumber')}</td>
  </tr>
  <tr>
    <td class="label-cell">전 화<span class="eng">Telephone</span></td>
    <td class="value">${v(data,'telephone')}</td>
    <td class="label-cell">무역업고유번호<span class="eng">Trade Business Code</span></td>
    <td class="value">${v(data,'tradeCode')}</td>
  </tr>
  <tr>
    <td class="label-cell">판정결과 공개<span class="eng">Consent to share</span></td>
    <td colspan="3">${ck(data.disclosure,'public')} 공개 (With all) &nbsp; ${ck(data.disclosure,'partial')} 일부공개 (With Specified Person) &nbsp; ${ck(data.disclosure,'private')} 비공개 (With None)</td>
  </tr>
  <tr>
    <th>② HS번호<br><span class="eng">HS Code</span></th>
    <td colspan="4" class="value">${v(data,'hsCode')}</td>
  </tr>
  <tr>
    <th>③ 물품명(기술명 및 기술내용)<br><span class="eng">Item</span></th>
    <td colspan="4" class="value">${v(data,'itemName')}</td>
  </tr>
  <tr>
    <th rowspan="2">④ 형식 및 규격<br><span class="eng">Type and Specifications</span></th>
    <td class="label-cell">모델번호 및 모델명<span class="eng">Model No. & Name</span></td>
    <td colspan="3" class="value">${v(data,'modelNumber')}</td>
  </tr>
  <tr>
    <td class="label-cell">규격/용도<span class="eng">Specifications/Usage</span></td>
    <td colspan="3" class="value" style="min-height:60px;white-space:pre-wrap">${v(data,'specUsage')}</td>
  </tr>
  <tr>
    <th rowspan="7">⑤ 판정 결과<br><span class="eng">Classification results</span></th>
    <td colspan="4" style="text-align:center; background:#f9f9f9; font-weight:500;">
      전략물자등 해당여부 (해당시 통제번호 기재)<br>
      <span class="eng">Controlled(Control Classification No.) / Uncontrolled</span>
    </td>
  </tr>
  <tr>
    <td class="label-cell">이중용도품목<span class="eng">Dual-Use Item(s)</span></td>
    <td colspan="3">${ck(data.dualUse,'yes')} 해당(Yes) &nbsp; ${ck(data.dualUse,'no')} 비해당(No) &nbsp; ${ck(data.dualUse,'except')} 예외적 비해당</td>
  </tr>
  <tr>
    <td class="label-cell">원자력전용품목<span class="eng">Trigger Item(s)</span></td>
    <td colspan="3">${ck(data.triggerItem,'yes')} 해당(Yes) &nbsp; ${ck(data.triggerItem,'no')} 비해당(No) &nbsp; ${ck(data.triggerItem,'except')} 예외적 비해당</td>
  </tr>
  <tr>
    <td class="label-cell">군용물자품목<span class="eng">Munition(s)</span></td>
    <td colspan="3">${ck(data.munition,'yes')} 해당(Yes) &nbsp; ${ck(data.munition,'no')} 비해당(No) &nbsp; ${ck(data.munition,'except')} 예외적 비해당</td>
  </tr>
  <tr>
    <td class="label-cell">상황허가대상<span class="eng">Catch-all Item(s)</span></td>
    <td colspan="3">${ck(data.catchAll,'yes')} 해당(Yes) &nbsp; ${ck(data.catchAll,'no')} 비해당(No)</td>
  </tr>
  <tr>
    <td class="label-cell">통제번호<span class="eng">Control Classification No.</span></td>
    <td colspan="3">${v(data,'controlNo')}</td>
  </tr>
  <tr>
    <td class="label-cell">통제체제<span class="eng">Control Regime</span></td>
    <td colspan="3">${ck(data.regime_wa_s,'yes')} [WA] 민감 &nbsp; ${ck(data.regime_wa_ss,'yes')} [WA] 초민감 &nbsp; ${ck(data.regime_nsg,'yes')} [NSG] Part1 민감 &nbsp; ${ck(data.regime_mtcr,'yes')} [MTCR] Cat1</td>
  </tr>
  <tr>
    <th>⑥ 판정 상세근거<br><span class="eng">Classification comments</span></th>
    <td colspan="4" class="value" style="min-height:80px;white-space:pre-wrap">${v(data,'classificationComments')}</td>
  </tr>
  <tr>
    <th>⑦ 유효기간<br><span class="eng">Validity</span></th>
    <td colspan="2" class="value">${v(data,'validity')}</td>
    <th class="label-cell">⑧ 발급번호<br><span class="eng">Issue No.</span></th>
    <td class="value">${v(data,'issueNo')}</td>
  </tr>
  <tr>
    <td colspan="5" style="padding: 20px 40px; text-align: center;">
      <p style="text-align: left; word-break: keep-all; margin-bottom: 5px;">「대외무역법」 제20조 및 동법 시행령 제36조제1항의 규정에 의하여 상기 품목에 대한 전략물자등 해당여부의 판정을 신청합니다.</p>
      <p style="text-align: left; color: #555; font-size: 8pt; margin-bottom: 30px;">I request for classification of the items as stated above as stipulated in Article 20 of the 「Foreign Trade Act」 and Article 36(1) of the Enforcement Decree of the 「Foreign Trade Act」.</p>
      <p style="margin-bottom: 20px; font-weight: bold;">20${v(data,'signYear')}. &nbsp;&nbsp;&nbsp;${v(data,'signMonth')}. &nbsp;&nbsp;&nbsp;${v(data,'signDay')}.</p>
      <p>신 청 인 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${v(data,'applicantName')} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(서명 또는 인)<br><span class="eng">Name of Applicant &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Signature</span></p>
    </td>
  </tr>
  <tr>
    <td colspan="5" style="padding: 20px 40px; text-align: center;">
      <p style="text-align: left; word-break: keep-all; margin-bottom: 5px;">「대외무역법 시행령」 제36조제2항의 규정에 의하여 제⑤항과 같이 전략물자등 해당여부를 확인합니다.</p>
      <p style="text-align: left; color: #555; font-size: 8pt; margin-bottom: 30px;">I hereby confirm the ruling of classification as stated in ⑤ above as stipulated in Article 36(2) of the Enforcement Decree of the 「Foreign Trade Act」.</p>
      <p style="margin-bottom: 20px; font-weight: bold;">20&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.</p>
      <p>기관장 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(인)<br><span class="eng">Sealed by Head of Classification Agency</span></p>
    </td>
  </tr>
</table>
<div class="note-area">
  <p>* 주의사항:</p>
  <p>1. ⑤ 판정결과가 "해당"인 물품을 수출할 경우 반드시 관계기관으로부터 수출허가를 받아야 하며, 무허가 수출시 관련 법령에 따라 처벌을 받게 됩니다.</p>
  <p>2. 잘못된 정보 등에 따른 판정오류 및 그로 인한 무허가 수출 등에 따른 책임은 신청자에게 있습니다.</p>
</div>
</body></html>`;
}

function tmpl_05(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제5호 - 자가판정서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제5호 서식] Annexed paper No. 5</div>
<div class="byeolji-title">자가판정서<br><span style="font-size:11pt">Self-classification Form</span></div>
<table class="byeolji-table">
  <tr>
    <th rowspan="4" style="width:100px">① 판정인<br><span class="eng">Company</span></th>
    <td class="label-cell">상 호<span class="eng">Name of Company</span></td>
    <td class="value">${v(data,'companyName')}</td>
    <td class="label-cell">대표자성명<span class="eng">Name of Representative</span></td>
    <td class="value">${v(data,'ceoName')}</td>
  </tr>
  <tr>
    <td class="label-cell">주 소<span class="eng">Address</span></td>
    <td colspan="3" class="value">${v(data,'address')}</td>
  </tr>
  <tr>
    <td class="label-cell">전 화<span class="eng">Telephone</span></td>
    <td class="value">${v(data,'telephone')}</td>
    <td class="label-cell">사업자등록번호<span class="eng">Business Reg. No.</span></td>
    <td class="value">${v(data,'regNumber')}</td>
  </tr>
  <tr>
    <td class="label-cell">무역업고유번호<span class="eng">Trade Business Code</span></td>
    <td colspan="3" class="value">${v(data,'tradeCode')}</td>
  </tr>
  <tr>
    <th>② HS번호<br><span class="eng">HS Code</span></th>
    <td colspan="4" class="value">${v(data,'hsCode')}</td>
  </tr>
  <tr>
    <th>③ 물품명<br><span class="eng">Item</span></th>
    <td colspan="4" class="value">${v(data,'itemName')}</td>
  </tr>
  <tr>
    <th rowspan="2">④ 형식 및 규격<br><span class="eng">Type and Specifications</span></th>
    <td class="label-cell">모델번호 및 모델명<span class="eng">Model No. & Name</span></td>
    <td colspan="3" class="value">${v(data,'modelNumber')}</td>
  </tr>
  <tr>
    <td class="label-cell">규격/용도<span class="eng">Specifications/Usage</span></td>
    <td colspan="3" class="value" style="min-height:50px;white-space:pre-wrap">${v(data,'specUsage')}</td>
  </tr>
  <tr>
    <th>⑤ 관련 통제체제</th>
    <td colspan="4">${ck(data.regime_wa,'yes')} WA &nbsp; ${ck(data.regime_nsg,'yes')} NSG &nbsp; ${ck(data.regime_mtcr,'yes')} MTCR &nbsp; ${ck(data.regime_ag,'yes')} AG &nbsp; ${ck(data.regime_cwc,'yes')} CWC &nbsp; ${ck(data.regime_bwc,'yes')} BWC &nbsp; ${ck(data.regime_att,'yes')} ATT</td>
  </tr>
  <tr>
    <th rowspan="3">⑥ 판정결과<br><span class="eng">Classification results</span></th>
    <td colspan="2">전략물자: ${ck(data.strategic,'yes')} 해당 &nbsp; ${ck(data.strategic,'no')} 비해당</td>
    <td colspan="2">상황허가대상: ${ck(data.catchAll,'yes')} 해당 &nbsp; ${ck(data.catchAll,'no')} 비해당</td>
  </tr>
  <tr>
    <td class="label-cell">통제번호</td>
    <td colspan="3">${v(data,'controlNo')}</td>
  </tr>
  <tr>
    <td colspan="4">${ck(data.regime_wa_s,'yes')} [WA] 민감 &nbsp; ${ck(data.regime_wa_ss,'yes')} [WA] 초민감 &nbsp; ${ck(data.regime_nsg_p1,'yes')} [NSG] Part1 민감 &nbsp; ${ck(data.regime_mtcr_c1,'yes')} [MTCR] Cat1</td>
  </tr>
  <tr>
    <th>⑦ 판정 상세근거<br><span class="eng">Comments</span></th>
    <td colspan="4" class="value" style="min-height:80px;white-space:pre-wrap">${v(data,'classificationComments')}</td>
  </tr>
  <tr>
    <th>⑧ 자가판정 등록번호<br><span class="eng">Reg. No.</span></th>
    <td colspan="4" class="value">${v(data,'selfClassRegNo')}</td>
  </tr>
  <tr>
    <th>⑨ 교육이수번호<br><span class="eng">Education Reg. No.</span></th>
    <td colspan="4" class="value">${v(data,'educationRegNo')}</td>
  </tr>
  <tr>
    <td colspan="5" style="padding: 20px 40px; text-align: center;">
      <p style="text-align: left; word-break: keep-all; margin-bottom: 5px;">「전략물자 수출입고시」제13조의 규정에 의하여 당사의 책임 하에 ⑥과 같이 전략물자등 해당여부를 확인합니다.</p>
      <p style="text-align: left; color: #555; font-size: 8pt; margin-bottom: 30px;">I hereby confirm and take full responsibility of the result of self-classification as stated in ⑥ above as stipulated in Article 13 of Public Notice on Trade of Strategic Items.</p>
      <p style="margin-bottom: 20px; font-weight: bold;">20${v(data,'signYear')}. &nbsp;&nbsp;&nbsp;${v(data,'signMonth')}. &nbsp;&nbsp;&nbsp;${v(data,'signDay')}.</p>
      <p>대표자 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${v(data,'ceoName')} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(서명 또는 인)<br><span class="eng">Representative of the Company &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (Signature)</span></p>
    </td>
  </tr>
</table>
<div class="note-area">
  <p>* 주의사항:</p>
  <p>1. ⑥ 판정결과가 "해당"인 물품을 수출할 경우 반드시 관계기관으로부터 수출허가를 받아야 하며, 무허가 수출시 관련 법령에 따라 처벌을 받게 됩니다.</p>
  <p>2. 잘못된 정보 등에 따른 판정오류 및 그로 인한 무허가 수출 등에 따른 책임은 신청자에게 있습니다.</p>
</div>
</body></html>`;
}

// ─── 별지 제13호: 자율준수무역거래자 지정신청서 ───
function tmpl_13(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제13호 - 지정신청서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제13호 서식]</div>
<div class="byeolji-title">자율준수무역거래자 지정신청서</div>
<p style="text-align:right;font-size:9pt;margin-bottom:10px">처리기간: 40일</p>
<table class="byeolji-table">
  <tr><td class="label-cell-wide">회사명</td><td colspan="3">${v(data,'companyName')}</td></tr>
  <tr><td class="label-cell-wide">사업자등록번호</td><td>${v(data,'regNumber')}</td><td class="label-cell">무역업고유(신고)번호</td><td>${v(data,'tradeCode')}</td></tr>
  <tr><td class="label-cell-wide">대표이사</td><td colspan="3">${v(data,'ceoName')}</td></tr>
  <tr><td class="label-cell-wide">주 소</td><td colspan="3">${v(data,'address')}</td></tr>
  <tr><td class="label-cell-wide">희망등급</td><td colspan="3">${ck(data.grade,'A')} A등급 &nbsp;&nbsp; ${ck(data.grade,'AA')} AA등급 &nbsp;&nbsp; ${ck(data.grade,'AAA')} AAA등급 (* 복수선택가능)</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">자율준수관리기구의 장</th></tr>
  <tr><td class="label-cell-wide">성 명</td><td>${v(data,'headName')}</td><td class="label-cell">소 속</td><td>${v(data,'headDept')}</td></tr>
  <tr><td class="label-cell-wide">직 위</td><td>${v(data,'headPosition')}</td><td class="label-cell">전 화</td><td>${v(data,'headPhone')}</td></tr>
  <tr><td class="label-cell-wide">팩 스</td><td>${v(data,'headFax')}</td><td class="label-cell">휴대전화</td><td>${v(data,'headMobile')}</td></tr>
  <tr><td class="label-cell-wide">전자우편</td><td colspan="3">${v(data,'headEmail')}</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">자율준수체제 담당자</th></tr>
  <tr><td class="label-cell-wide">성 명</td><td>${v(data,'staffName')}</td><td class="label-cell">소 속</td><td>${v(data,'staffDept')}</td></tr>
  <tr><td class="label-cell-wide">직 위</td><td>${v(data,'staffPosition')}</td><td class="label-cell">전 화</td><td>${v(data,'staffPhone')}</td></tr>
  <tr><td class="label-cell-wide">팩 스</td><td>${v(data,'staffFax')}</td><td class="label-cell">휴대전화</td><td>${v(data,'staffMobile')}</td></tr>
  <tr><td class="label-cell-wide">전자우편</td><td colspan="3">${v(data,'staffEmail')}</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">판정담당자</th></tr>
  <tr><td class="label-cell-wide">성 명</td><td>${v(data,'classifierName')}</td><td class="label-cell">소 속</td><td>${v(data,'classifierDept')}</td></tr>
  <tr><td class="label-cell-wide">직 위</td><td>${v(data,'classifierPosition')}</td><td class="label-cell">전 화</td><td>${v(data,'classifierPhone')}</td></tr>
  <tr><td class="label-cell-wide">팩 스</td><td>${v(data,'classifierFax')}</td><td class="label-cell">휴대전화</td><td>${v(data,'classifierMobile')}</td></tr>
  <tr><td class="label-cell-wide">전자우편</td><td colspan="3">${v(data,'classifierEmail')}</td></tr>
</table>
<div class="signature-area">
  <p style="font-size:9pt;text-align:left">「전략물자수출입고시」제78조의 규정에 의하여 위와 같이 자율준수무역거래자로 지정해 줄 것을 신청합니다. 향후 모든 수출거래에 대해 「대외무역법」 등을 준수할 것이며, 자율준수체제의 중요 사항 변경이나 의심스러운 거래에 대해서는 산업통상부장관에게 우선적으로 보고하겠습니다.</p>
  <p style="margin-top:15px">20${v(data,'signYear')}. ${v(data,'signMonth')}. ${v(data,'signDay')}.</p>
  <p style="margin-top:10px">대표자 ${v(data,'ceoName')} (서명 또는 인)</p>
</div>
</body></html>`;
}

// ─── 별지 제15호: 회사소개서 ───
function tmpl_15(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제15호 - 회사소개서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제15호 서식] Annexed paper No. 15</div>
<div class="byeolji-title">회 사 소 개 서</div>
<table class="byeolji-table">
  <tr><td class="label-cell-wide">① 회사명(영문)</td><td colspan="3">${v(data,'companyName')}<br><span class="eng">${v(data,'companyNameEn')}</span></td></tr>
  <tr><td class="label-cell-wide">② 대표자</td><td>직책: ${v(data,'ceoTitle')}</td><td colspan="2">성명: ${v(data,'ceoName')}</td></tr>
  <tr><td class="label-cell-wide">③ 주소</td><td colspan="3">${v(data,'address')}</td></tr>
  <tr><td class="label-cell-wide">④ 사업내용</td><td>업태: ${v(data,'businessType')}</td><td>종목: ${v(data,'businessItem')}</td><td>외투기업여부: ${v(data,'foreignInvest','해당없음')}</td></tr>
  <tr><td class="label-cell-wide">⑤ 주요취급품목</td><td colspan="3">${v(data,'mainProducts')}</td></tr>
  <tr><td class="label-cell-wide">⑥ 기업규모</td><td colspan="3">자본금 ${v(data,'capital')} 백만원 / 임직원수 ${v(data,'employeeCount')} 명 / 연간매출액 ${v(data,'revenue')} 백만원 (신청직전년도)</td></tr>
  <tr>
    <td class="label-cell-wide" rowspan="2">⑦ 주요주주</td>
    <td>주주명: ${v(data,'shareholder1')}</td><td>소유비율: ${v(data,'shareRatio1')}%</td>
    <td></td>
  </tr>
  <tr>
    <td>주주명: ${v(data,'shareholder2')}</td><td>소유비율: ${v(data,'shareRatio2')}%</td>
    <td></td>
  </tr>
  <tr><td class="label-cell-wide">⑧ 자율수출관리기구의 장</td><td>직위: ${v(data,'headPosition')}</td><td colspan="2">성명: ${v(data,'headName')}</td></tr>
  <tr><td class="label-cell-wide">⑨ 자율준수관리기구의 명칭</td><td colspan="3">${v(data,'orgName')}</td></tr>
  <tr><td class="label-cell-wide">⑩ 수출관리 종사자 총수</td><td colspan="3">${v(data,'totalStaff')} 명 (전임 ${v(data,'fullTimeStaff')} 명)</td></tr>
  <tr><td class="label-cell-wide">⑪ 담당자</td><td>소속: ${v(data,'contactDept')} / 성명: ${v(data,'contactName')}</td><td>전화: ${v(data,'contactPhone')}</td><td>전자우편: ${v(data,'contactEmail')}</td></tr>
  <tr><td class="label-cell-wide">⑫ 담당자 주소</td><td colspan="3">${v(data,'contactAddress','③과 동일')}</td></tr>
  <tr><td class="label-cell-wide">⑬ 수출총액</td><td colspan="3">${v(data,'exportTotal')} 백만원 / 매출액 대비 ${v(data,'exportRatio')}% (신청직전년도) / 전략물자 비율 약 ${v(data,'strategicRatio')}%</td></tr>
  <tr><td class="label-cell-wide">⑭ 나의1 지역 수출상황</td><td colspan="3" style="white-space:pre-wrap">${v(data,'exportRegion1')}</td></tr>
  <tr><td class="label-cell-wide">⑮ 나의2 지역 수출상황</td><td colspan="3" style="white-space:pre-wrap">${v(data,'exportRegion2')}</td></tr>
  <tr><td class="label-cell-wide">⑯ 전략물자 목적지국가 및 수입자</td><td colspan="3" style="white-space:pre-wrap">${v(data,'strategicDestinations')}</td></tr>
  <tr><td class="label-cell-wide">⑰ 상황허가대상품목 목적지국가 및 수입자</td><td colspan="3" style="white-space:pre-wrap">${v(data,'catchAllDestinations')}</td></tr>
  <tr><td class="label-cell-wide">⑱ 우려거래자 수출상황</td><td colspan="3" style="white-space:pre-wrap">${v(data,'concernedParties')}</td></tr>
  <tr><td class="label-cell-wide">⑲ 연간 개별수출허가건수</td><td colspan="3">전략물자 ${v(data,'strategicPermitCount')} 건 / 상황허가대상품목 ${v(data,'catchAllPermitCount')} 건</td></tr>
  <tr><td class="label-cell-wide">⑳ 비고</td><td colspan="3" style="min-height:60px;white-space:pre-wrap">${v(data,'remarks')}</td></tr>
</table>
</body></html>`;
}

// ─── 별지 제16호: 사전거래보고서 ───
function tmpl_16(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제16호 - 사전거래보고서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제16호 서식]</div>
<div class="byeolji-title">사전거래보고서</div>
<table class="byeolji-table">
  <tr><th colspan="4" style="background:#e8e8e8">□ 무역거래자 정보</th></tr>
  <tr><td class="label-cell-wide">사업자등록번호</td><td colspan="3">${v(data,'regNumber')}</td></tr>
  <tr><td class="label-cell-wide">① 수출자</td><td colspan="3">${v(data,'exporter')}</td></tr>
  <tr><td class="label-cell-wide">② 실무담당자</td><td colspan="3">${v(data,'contactPerson')}</td></tr>
  <tr><td class="label-cell-wide">③ 구매자</td><td colspan="3">${v(data,'buyer')}</td></tr>
  <tr><td class="label-cell-wide">④ 제조자</td><td colspan="3">${v(data,'manufacturer')}</td></tr>
  <tr><td class="label-cell-wide">⑤ 최종수하인</td><td colspan="3">${v(data,'consignee')}</td></tr>
  <tr><td class="label-cell-wide">⑥ 최종사용자</td><td colspan="3">${v(data,'endUser')}</td></tr>
  <tr><td class="label-cell-wide">⑦ 거래유형</td><td colspan="3">${ck(data.tradeType,'export')} 수출 &nbsp; ${ck(data.tradeType,'broker')} 중개 &nbsp; ${ck(data.tradeType,'transit')} 경유 또는 환적</td></tr>
  <tr><td class="label-cell-wide">⑧ 최종목적지국가</td><td>${v(data,'destCountry')}</td><td class="label-cell">⑨ 최종사용용도</td><td>${v(data,'endUse')}</td></tr>
  <tr><td class="label-cell-wide">⑩ 판정번호</td><td>${v(data,'classNo')}</td><td class="label-cell">⑪ HS 번호</td><td>${v(data,'hsCode')}</td></tr>
  <tr><td class="label-cell-wide">⑫ 통제번호</td><td colspan="3">${v(data,'controlNo')}</td></tr>
  <tr><td class="label-cell-wide">⑬ 품명 및 규격</td><td>${v(data,'itemSpec')}</td><td class="label-cell">⑭ 단위 및 수량</td><td>${v(data,'quantity')}</td></tr>
  <tr><td class="label-cell-wide">⑮ 수출액(USD)</td><td colspan="3">${v(data,'exportAmount')}</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">□ 최종사용자 정보</th></tr>
  <tr><td class="label-cell-wide">⑯ 회사명</td><td>${v(data,'euCompany')}</td><td class="label-cell">⑰ 주소지</td><td>${v(data,'euAddress')}</td></tr>
  <tr><td class="label-cell-wide">⑱ 업종/업태</td><td>${v(data,'euBusiness')}</td><td class="label-cell">⑲ 자본금</td><td>${v(data,'euCapital')}</td></tr>
  <tr><td class="label-cell-wide">⑳ 고용인원</td><td>${v(data,'euEmployees')}</td><td class="label-cell">㉑ 주요고객사</td><td>${v(data,'euClients')}</td></tr>
  <tr><td class="label-cell-wide">㉒ 소유주</td><td>${v(data,'euOwner')}</td><td class="label-cell">㉓ 지분구조</td><td>${v(data,'euShares')}</td></tr>
  <tr><td class="label-cell-wide">㉔ 홈페이지</td><td>${v(data,'euWebsite')}</td><td class="label-cell">㉕ 주요생산품</td><td>${v(data,'euProducts')}</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">□ 허가면제사유</th></tr>
  <tr><td colspan="4" style="white-space:pre-wrap">${v(data,'exemptionReason')}</td></tr>
  <tr><th colspan="4" style="background:#e8e8e8">□ 거래내역 (수출 후 작성)</th></tr>
  <tr><td class="label-cell-wide">㉗ 선적일</td><td>${v(data,'shipDate')}</td><td class="label-cell">㉘ B/L 번호</td><td>${v(data,'blNumber')}</td></tr>
  <tr><td class="label-cell-wide">㉙ 수출신고수리번호</td><td colspan="3">${v(data,'exportDeclNo')}</td></tr>
</table>
<div class="signature-area">
  <p>위 신고내용이 사실임을 확인합니다.</p>
  <p style="margin-top:15px">20${v(data,'signYear')}. ${v(data,'signMonth')}. ${v(data,'signDay')}.</p>
  <p style="margin-top:10px">신고인 ${v(data,'signerName')} (서명 또는 인)</p>
</div>
</body></html>`;
}

// ─── 별지 제16호의2: 사후거래보고서 (사전거래보고서와 거의 동일 구조) ───
function tmpl_16_2(data) {
  let html = tmpl_16(data);
  return html.replace('별지 제16호 서식', '별지 제16호의2 서식')
             .replace('사전거래보고서', '사후거래보고서')
             .replace('별지 제16호 - 사전거래보고서', '별지 제16호의2 - 사후거래보고서');
}

// ─── 별지 제18호: 자율준수체제 운영 보고서 ───
function tmpl_18(data) {
  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제18호 - 운영 보고서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제18호 서식] Annexed paper No. 18</div>
<div class="byeolji-title">자율준수체제 운영 보고서</div>
<table class="byeolji-table">
  <tr>

    <td class="label-cell">제정</td><td>${v(data,'regEstablished')}</td>
  </tr>
  <tr><td class="label-cell">개정</td><td>${v(data,'regRevised')}</td></tr>
  <tr><td class="label-cell">주요 개정사항</td><td style="white-space:pre-wrap">${v(data,'regChanges')}</td></tr>
  <tr>
    <th>② 자율준수관리조직<br>운영현황</th>
    <td class="label-cell">자율준수관리기구의 장 / 전담기구인원 / 기술부문 / 영업부문</td>
    <td style="white-space:pre-wrap">${v(data,'orgStatus')}</td>
  </tr>
  <tr>
    <th rowspan="2">③ 수출통제교육현황</th>
    <td class="label-cell">외부교육 참가실적</td><td style="white-space:pre-wrap">${v(data,'extTraining')}</td>
  </tr>
  <tr><td class="label-cell">내부교육 추진실적</td><td style="white-space:pre-wrap">${v(data,'intTraining')}</td></tr>
  <tr>
    <th>④ 내부감사 운영현황</th>
    <td class="label-cell">내부감사 운영실적</td><td style="white-space:pre-wrap">${v(data,'auditStatus')}</td>
  </tr>
</table>
<div class="signature-area">
  <p>「대외무역법」 제25조 제3항 및 동법 시행령 제45조의 규정에 의하여 20${v(data,'reportYear')}년도 당사의 자율준수체제 운영현황을 보고합니다.</p>
  <p style="margin-top:15px">20${v(data,'signYear')}. ${v(data,'signMonth')}. ${v(data,'signDay')}.</p>
  <p style="margin-top:10px">보고자 ${v(data,'reporterName')} (서명 또는 인)</p>
  <p>산업통상부장관 귀중</p>
</div>
</body></html>`;
}

// ─── 별지 제19호: 실적 보고서 ───
function tmpl_19(data) {
  const getRows = (key) => data[key] && Array.isArray(data[key]) ? data[key] : [];
  
  const brokerageRows = getRows('②_중개_상세내역');
  const compRows = getRows('③-2_포괄수출_허가_건별_상세실적');
  const techRows = getRows('④_1._전략기술_무형이전_(A등급_이상)');
  const exemptRows = getRows('④_2._개별수출허가_면제대상_(AAA등급_한함)');
  const selfRows = getRows('⑤_1._자가판정_건수');
  const expertRows = getRows('⑤_2._전문판정_건수');

  const renderTableRows = (rows, cols) => {
    if (rows.length === 0) return '해당없음(N/A)';
    return rows.map(r => cols.map(c => v(r, c)).join(' / ')).join('<br>');
  };

  return `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>별지 제19호 - 실적 보고서</title>${commonStyle}</head><body>${printButton}
<div class="byeolji-subtitle">[별지 제19호 서식] Annexed paper No. 19</div>
<div class="byeolji-title">자율준수무역거래자 실적 보고서</div>
<table class="byeolji-table">
  <tr><th style="width:180px">① 중개실적</th><td colspan="2">중개 건수/금액: ${v(data,'brokerage_count_amount')}</td></tr>
  <tr><th rowspan="6">② 중개 상세내역</th>
      <td style="width:150px; background:#f5f5f5;">- 품명(모델) 및 통제번호</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.item || '').join('<br>')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 용도</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.usage || '').join('<br>')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 수출국가명 및 지역</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.export_country || '').join('<br>')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 수입국가명 및 지역</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.import_country || '').join('<br>')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 수입자</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.importer || '').join('<br>')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 최종수하인</td>
      <td style="white-space:pre-wrap">${brokerageRows.map(r => r.end_user || '').join('<br>')}</td>
  </tr>
  <tr>
      <th rowspan="2">③ 포괄수출허가 및<br>포괄수출실적*</th>
      <td style="background:#f5f5f5;">- 포괄수출허가건수/실적건수/금액</td>
      <td>${v(data,'comprehensive_count_amount')}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">- 허가 건별 상세실적 및 금액</td>
      <td style="white-space:pre-wrap">${renderTableRows(compRows, ['details', 'amount'])}</td>
  </tr>
  <tr>
      <th rowspan="2">④ 허가면제<br>실적보고</th>
      <td style="background:#f5f5f5;">④ 1. 전략기술의 무형이전<br>(A등급 이상)</td>
      <td style="white-space:pre-wrap">${renderTableRows(techRows, ['tech', 'target', 'period'])}</td>
  </tr>
  <tr>
      <td style="background:#f5f5f5;">④ 2. 그 외 개별수출허가 면제대상<br>(AAA등급에 한함)</td>
      <td style="white-space:pre-wrap">${renderTableRows(exemptRows, ['type', 'history', 'consumer'])}</td>
  </tr>
  <tr>
      <th>⑤ 전략물자 판정</th>
      <td colspan="2" style="white-space:pre-wrap">자가판정:<br>${renderTableRows(selfRows, ['classNo', 'criteria', 'result'])}<br><br>전문판정:<br>${renderTableRows(expertRows, ['classNo', 'criteria', 'result'])}</td>
  </tr>
</table>
<div class="signature-area">
  <p>「대외무역법」 제25조 제3항 및 동법 시행령 제45조의 규정에 의하여 20${v(data,'reportYear')}년 ${v(data,'reportHalf','상')}/하반기 자율준수무역거래자 포괄수출실적 및 허가면제내역을 보고합니다.</p>
  <p style="margin-top:15px">20${v(data,'signYear')}. ${v(data,'signMonth')}. ${v(data,'signDay')}.</p>
  <p style="margin-top:10px">보고자 ${v(data,'reporterName')} (서명 또는 인)</p>
  <p>산업통상자원부장관 귀하</p>
</div>
</body></html>`;
}



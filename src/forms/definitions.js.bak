    author: '자율수출관리부서 / 교육담당자',
    retention: '5년',
    type: 'template',
    fields: [
      { key: 'planYear', label: '계획 연도', type: 'text', default: '2026년도' },
      { key: 'drafter', label: '작성자 / 부서', type: 'text', default: '이무역 대리 (자율수출관리기구)' },
